---
// A screen in a window frame. `eager` for the one above the fold.
import { SCREENS } from '../data/screens'
interface Props { screen: keyof typeof SCREENS; eager?: boolean; class?: string }
const { screen, eager = false, class: cls = '' } = Astro.props
const s = SCREENS[screen]
---
<figure class={`window ${cls}`} style="margin:0">
  <div class="window-bar" aria-hidden="true"><i></i><i></i><i></i><span>{s.title}</span></div>
  <img
    src={s.src}
    alt={s.alt}
    width={s.width}
    height={s.height}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : undefined}
  />
</figure>
