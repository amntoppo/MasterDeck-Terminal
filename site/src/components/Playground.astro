---
// A small, draggable copy of the Workflow canvas. x/y are fractions of the canvas.
const NODES = [
  { id: 'start', kind: 't', tag: 'Trigger', label: 'Session starts', x: 0.13, y: 0.3, mx: 0.27, my: 0.13 },
  { id: 'move', kind: 'b', tag: 'Built-in', label: 'Move card → In Dev', x: 0.38, y: 0.3, mx: 0.27, my: 0.34 },
  { id: 'pre', kind: 't', tag: 'Trigger', label: 'Before the PR', x: 0.13, y: 0.74, mx: 0.73, my: 0.13 },
  { id: 'review', kind: 's', tag: 'Skill', label: '/review the diff', x: 0.38, y: 0.74, mx: 0.73, my: 0.34 },
  { id: 'loop', kind: 'l', tag: 'Agent loop · soon', label: 'Fix until tests pass', x: 0.63, y: 0.52, mx: 0.5, my: 0.58 },
  { id: 'watch', kind: 'b', tag: 'Built-in', label: 'PR watch', x: 0.87, y: 0.3, mx: 0.27, my: 0.84 },
  { id: 'notify', kind: 'n', tag: 'Action', label: 'Notify me', x: 0.87, y: 0.76, mx: 0.73, my: 0.84 },
]
const EDGES = [
  { from: 'start', to: 'move', kind: 'then' },
  { from: 'pre', to: 'review', kind: 'then' },
  { from: 'move', to: 'loop', kind: 'then' },
  { from: 'review', to: 'loop', kind: 'then' },
  { from: 'loop', to: 'watch', kind: 'ok' },
  { from: 'loop', to: 'notify', kind: 'fail' },
  { from: 'loop', to: 'review', kind: 'loop' },
]
---
<div
  class="playground"
  data-playground
  data-edges={JSON.stringify(EDGES)}
  data-order="start,move,pre,review,loop,watch"
  role="group"
  aria-label="An example workflow. Drag the blocks, or focus one and use the arrow keys."
>
  <div class="pg-bar" aria-hidden="true">
    <span class="tag">workflow: Default</span><span class="tag">7 blocks</span>
    <span class="hint">Drag the blocks ↔</span>
  </div>
  <svg class="edges" aria-hidden="true"></svg>
  {
    NODES.map((n) => (
      <div class={`node ${n.kind}`} data-node={n.id} data-x={n.x} data-y={n.y} data-mx={n.mx} data-my={n.my} tabindex="0" aria-label={`${n.tag}: ${n.label}`}>
        <small>{n.tag}</small>
        <b>{n.label}</b>
      </div>
    ))
  }
</div>
<div class="legend" aria-hidden="true">
  <span><i style="border-color: var(--accent)"></i>then</span>
  <span><i style="border-color: var(--green)"></i>if it worked</span>
  <span><i style="border-color: var(--red)"></i>if it failed</span>
  <span><i style="border-color: var(--accent-2); border-top-style: dashed"></i>loop until done (coming soon)</span>
</div>
<style>
  .playground { height: 470px; }
  .node { left: 0; top: 0; }
  @media (max-width: 760px) {
    .playground { height: 620px; }
    .node { width: 132px; padding: 10px 11px; }
    .node b { font-size: 13px; }
    .pg-bar .hint { display: none; }
  }
</style>
