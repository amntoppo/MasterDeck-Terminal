---
import Logo from './Logo.astro'
import Icon from './Icon.astro'
import { NAV, REPO } from '../data/site'

const path = Astro.url.pathname.replace(/\/?$/, '/')
const current = (href: string) => (!href.includes('#') && path === href ? 'page' : undefined)
---
<header class="site-header" data-header>
  <nav class="wrap nav" aria-label="Main">
    <a class="logo" href="/" aria-label="MasterDeck home"><Logo /><span>MasterDeck</span></a>
    <ul class="nav-links">
      {NAV.map((n) => <li><a href={n.href} aria-current={current(n.href)}>{n.label}</a></li>)}
    </ul>
    <div class="nav-right">
      <a class="icon-btn" href={REPO} aria-label="MasterDeck on GitHub"><Icon name="github" /></a>
      <button class="icon-btn theme-toggle" type="button" aria-label="Switch between light and dark theme" data-theme-toggle>
        <span class="moon"><Icon name="moon" /></span><span class="sun"><Icon name="sun" /></span>
      </button>
      <a class="btn btn-primary btn-sm" href="/download/"><Icon name="download" />Download</a>
      <button class="icon-btn menu-btn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="mobile-nav" data-menu>
        <Icon name="menu" />
      </button>
    </div>
  </nav>
  <div class="mobile-nav" id="mobile-nav" data-mobile-nav>
    <ul>
      {NAV.map((n) => <li><a href={n.href} aria-current={current(n.href)}>{n.label}</a></li>)}
      <li><a href={REPO}>GitHub</a></li>
    </ul>
    <a class="btn btn-primary" href="/download/"><Icon name="download" />Download MasterDeck</a>
  </div>
</header>
