---
import Logo from './Logo.astro'
import { REPO, RELEASES, GUIDE, WEB_APP, ISSUES } from '../data/site'
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="logo" href="/"><Logo /><span>MasterDeck</span></a>
        <p class="footer-blurb">The command center for Claude Code. Open source, for macOS and Windows.</p>
      </div>
      <div>
        <h2>Product</h2>
        <ul>
          <li><a href="/features/">Features</a></li>
          <li><a href="/download/">Download</a></li>
          <li><a href="/download/#changelog">Changelog</a></li>
          <li><a href={WEB_APP}>Web app</a></li>
        </ul>
      </div>
      <div>
        <h2>Docs</h2>
        <ul>
          <li><a href="/docs/">Get started</a></li>
          <li><a href="/docs/#github">Connect GitHub</a></li>
          <li><a href={GUIDE}>User guide</a></li>
          <li><a href="/docs/#remote">From a phone</a></li>
        </ul>
      </div>
      <div>
        <h2>Open source</h2>
        <ul>
          <li><a href={REPO}>GitHub</a></li>
          <li><a href={RELEASES}>Releases</a></li>
          <li><a href={ISSUES}>Issues</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-base">
      <span>© {new Date().getFullYear()} MasterDeck. Not affiliated with Anthropic.</span>
      <span>Claude and Claude Code are trademarks of Anthropic.</span>
    </div>
  </div>
</footer>
