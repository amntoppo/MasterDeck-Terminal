---
// A shell block with a Copy button. Lines starting with "#" are comments; others get a prompt.
import Icon from './Icon.astro'
const { code } = Astro.props as { code: string }
const lines = code.trim().split('\n')
const commands = lines.filter((l) => l && !l.startsWith('#')).join('\n')
---
<pre class="code"><code>{lines.map((l) => (l.startsWith('#') ? <span class="c">{l}{'\n'}</span> : <span><span class="p">$ </span>{l}{'\n'}</span>))}</code><button class="copy-btn" type="button" data-copy={commands} aria-label="Copy the commands"><Icon name="copy" /><span>Copy</span></button></pre>
<style>
  .copy-btn :global(svg) { width: 14px; height: 14px; }
</style>
