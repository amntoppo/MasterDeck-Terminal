---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import Shot from '../components/Shot.astro'
import Playground from '../components/Playground.astro'
import { GUIDE, WEB_APP } from '../data/site'
---
<Base
  title="Features"
  og="features"
  description="Sessions, Needs you, the GitHub board, workflows with agent loops, costs and hours, several GitHub accounts and a web app: everything MasterDeck does for Claude Code."
>
  <section class="page-hero">
    <div class="bg-grid"></div>
    <div class="bg-glow"></div>
    <div class="wrap">
      <span class="eyebrow" data-reveal>Features</span>
      <h1 class="h-xl" data-split>Everything around the terminal, <span class="grad">done for you.</span></h1>
      <p class="lede" data-reveal style="--i: 2">
        MasterDeck is a front end for your Claude Code sessions and your GitHub. It watches, links, moves and reminds, and asks
        you before it acts.
      </p>
      <nav class="feature-nav" aria-label="Features on this page" data-reveal style="--i: 3">
        <a href="#sessions">Sessions</a><a href="#board">Tasks and the board</a><a href="#workflows">Workflows</a>
        <a href="#costs">Costs</a><a href="#accounts">Accounts</a><a href="#more">And more</a>
      </nav>
    </div>
  </section>

  <section class="section" style="padding-top: 24px">
    <div class="wrap">
      <div class="feature" id="sessions">
        <div class="feature-copy" data-reveal="left">
          <span class="eyebrow">Sessions</span>
          <h2>Every session, its real terminal.</h2>
          <p>
            Each Claude Code session is a tab running <code>claude attach</code>: the real terminal, not a copy. Closing a tab only
            detaches; the background session keeps working.
          </p>
          <ul class="checks">
            <li>Grouped by what each needs: Needs you, Working, In review, Idle, Merged</li>
            <li>Details: what it waits on, ticket, PRs, worktrees, diff, tokens, context, model</li>
            <li>Split view, starred sessions, filters by status, account and repository</li>
            <li>Broadcast, quick reply, Continue and Compact, never onto a permission prompt</li>
            <li>A command palette (<kbd>⌘K</kbd>) for every session, issue, PR and action</li>
          </ul>
        </div>
        <div class="feature-media" data-reveal="right"><Shot screen="sessions" /></div>
      </div>

      <div class="feature flip" id="board">
        <div class="feature-copy" data-reveal="right">
          <span class="eyebrow">Tasks and the board</span>
          <h2>Tickets in, PRs out.</h2>
          <p>
            Your sprint from GitHub Projects as a Kanban board. Click a ticket and a session starts in the checkout of its
            repository, linked to the issue. MasterDeck moves the card as the work moves.
          </p>
          <ul class="checks">
            <li>In Dev on start, PR Raised on the PR, Dev Done on the merge</li>
            <li>No GitHub project? Columns worked out from your repositories’ issues, and Create a GitHub board</li>
            <li>A repository view: every issue of a repository, on a board or not</li>
            <li>Assign, sub-issues and descriptions in the card’s popup; filters by person, sprint and repository</li>
            <li>Tasks: what master proposes, approved or held, in one list</li>
          </ul>
        </div>
        <div class="feature-media" data-reveal="left"><Shot screen="board" /></div>
      </div>

      <div class="feature" id="workflows">
        <div class="feature-copy" data-reveal="left">
          <span class="eyebrow">Workflows</span>
          <h2>Draw how work gets shipped.</h2>
          <p>
            A canvas where you decide what sessions do from an issue to a merged PR. Triggers start it, skills and instructions do
            the work, and arrows pick the next step by how the last one went.
          </p>
          <ul class="checks">
            <li>Triggers: session starts, after a push, before the PR, PR merged, a command matching a pattern, idle for N minutes</li>
            <li>Every skill you have, plugin skills and each repository’s own</li>
            <li><b>Build with Claude</b>: describe a workflow, get it on the canvas, apply or discard</li>
            <li>Custom triggers on any Claude Code hook, tool, path or output</li>
          </ul>
          <p><span class="badge"><Icon name="loop" />Coming soon</span>&nbsp; <b>Agent loops</b>: a step that runs again and again until a goal is met, such as the tests passing, with limits on rounds, time and spend.</p>
        </div>
        <div class="feature-media" data-reveal="right"><Shot screen="workflow" /></div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow" data-reveal>Try it</span>
        <h2 class="h-lg" data-reveal style="--i: 1">Drag a workflow around.</h2>
      </div>
      <div data-reveal="zoom"><Playground /></div>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="wrap">
      <div class="feature flip" id="costs">
        <div class="feature-copy" data-reveal="right">
          <span class="eyebrow">Costs</span>
          <h2>See where the money goes.</h2>
          <p>
            Spend and tokens from Claude Code’s own status line, recorded per session per day and summed per ticket. Set a budget
            per ticket and get told when one passes it.
          </p>
          <ul class="checks">
            <li>Today, 7 and 30 days, and a 14-day chart, in USD or tokens</li>
            <li>Tables per ticket and per session; each board card shows its spend</li>
            <li>Context warnings at 85%, with Compact now</li>
            <li>Hours: an estimate per account, day and ticket, exported as CSV</li>
          </ul>
        </div>
        <div class="feature-media" data-reveal="left"><Shot screen="costs" /></div>
      </div>

      <div class="feature" id="accounts">
        <div class="feature-copy" data-reveal="left">
          <span class="eyebrow">Several GitHub accounts</span>
          <h2>Work and side projects, one window.</h2>
          <p>
            Connect every account <code>gh</code> is logged in to. Each session, Board tab and PR tab works as one account, with
            its own token, commit name and email, and its own workspace folder. MasterDeck never runs <code>gh auth switch</code>.
          </p>
          <ul class="checks">
            <li>Pick the account in the Start dialog; resumes keep it</li>
            <li>A shared GitHub cache, keyed per account, so many sessions don’t use up your rate limit</li>
            <li>Tokens stay on your Mac (mode 600)</li>
          </ul>
        </div>
        <div class="feature-media accounts" data-reveal="right" aria-label="Two connected accounts" role="img">
          <div class="acct"><span class="av" style="background: linear-gradient(135deg, #79a8ff, #4f7bdc)">AC</span><div><b>@acme-dev</b><small>acme · 12 repos · board “Sprint”</small></div><span class="tag">primary</span></div>
          <div class="acct"><span class="av" style="background: linear-gradient(135deg, #b08cff, #7a4ff0)">SP</span><div><b>@side-project</b><small>side-project · 3 repos · no board</small></div><span class="tag">connected</span></div>
          <div class="acct" style="opacity: 0.6"><span class="av" style="background: #5d616c">+</span><div><b>Add an account…</b><small>runs gh auth login --web</small></div></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="more" style="padding-top: 0">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow" data-reveal>And more</span>
        <h2 class="h-lg" data-reveal style="--i: 1">The small things that add up.</h2>
      </div>
      <div class="minis">
        <article class="card" data-reveal><div class="ico"><Icon name="globe" /></div><h3>Web app and phone</h3><p>Sign in at <a href={WEB_APP}>app.masterdeck.dev</a> to reach your Mac’s sessions, board and live terminals, end-to-end encrypted.</p></article>
        <article class="card" data-reveal style="--i: 1"><div class="ico"><Icon name="pr" /></div><h3>PR watch</h3><p>Review comments, conflicts and the merge of a session’s PR go back to that session.</p></article>
        <article class="card" data-reveal style="--i: 2"><div class="ico"><Icon name="shield" /></div><h3>Self-review gate</h3><p>The first <code>gh pr create</code> on each branch stops for a self-review of the diff.</p></article>
        <article class="card" data-reveal><div class="ico"><Icon name="note" /></div><h3>Notes</h3><p>Your own notes and one per ticket, in Markdown, kept on your Mac. Sessions can add to them.</p></article>
        <article class="card" data-reveal style="--i: 1"><div class="ico"><Icon name="terminal" /></div><h3>/queue</h3><p>Queue a prompt to run after the current answer, and edit the queue in a panel.</p></article>
        <article class="card" data-reveal style="--i: 2"><div class="ico"><Icon name="spark" /></div><h3>Hygiene</h3><p>Standup notes from your commits, a worktree janitor, history search, templates and broadcast.</p></article>
      </div>
      <p class="muted" style="margin-top: 28px" data-reveal>Every feature, in detail: the <a href={GUIDE}>user guide</a>.</p>
    </div>
  </section>

  <section class="section" style="padding-top: 0">
    <div class="wrap">
      <div class="cta" data-reveal="zoom">
        <h2 class="h-lg">Ready when you are.</h2>
        <div class="btn-row" style="justify-content: center">
          <a class="btn btn-primary" href="/download/"><Icon name="download" />Download</a>
          <a class="btn" href="/docs/">Read the setup <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>
</Base>
