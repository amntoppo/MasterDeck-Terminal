---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
---
<Base title="Not found" description="This page does not exist on masterdeck.dev." noindex>
  <section class="section">
    <div class="wrap nf">
      <div style="display: grid; gap: 18px; justify-items: center">
        <span class="eyebrow">404</span>
        <h1 class="h-lg">No session by that name.</h1>
        <p class="lede">The page you asked for isn’t here. It may have moved.</p>
        <div class="btn-row" style="justify-content: center">
          <a class="btn btn-primary" href="/">Home <Icon name="arrow" /></a>
          <a class="btn" href="/docs/">Get started</a>
        </div>
      </div>
    </div>
  </section>
</Base>
