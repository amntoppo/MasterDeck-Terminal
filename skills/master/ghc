#!/usr/bin/env bash
# ghc — `gh` through the shared GitHub cache (see lib/master/ghcache.py). Same arguments as gh.
#   ghc [--ttl SECONDS] [--no-cache] <gh args...>     ghc --status
DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$0")")" && pwd)"
PYTHONPATH="$DIR/lib" exec python3 -m master.ghcache "$@"
